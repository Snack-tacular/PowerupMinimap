<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>PowerupMinimap</AssemblyName>
    <RootNamespace>PowerupMinimap</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>

    <BepInCore>C:\Program Files (x86)\Steam\steamapps\common\Sineus Arena\BepInEx\core</BepInCore>
    <BepInInterop>C:\Program Files (x86)\Steam\steamapps\common\Sineus Arena\BepInEx\interop</BepInInterop>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 6 IL2CPP Core Assemblies -->
    <Reference Include="BepInEx.Core" HintPath="$(BepInCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(BepInCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(BepInCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInCore)\0Harmony.dll" Private="false" />

    <!-- Essential IL2CPP Core System References -->
    <Reference Include="Il2Cppmscorlib" HintPath="$(BepInInterop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="Il2CppSystem" HintPath="$(BepInInterop)\Il2CppSystem.dll" Private="false" />

    <!-- Unstripped / Generated Game Interop Assemblies -->
    <Reference Include="Assembly-CSharp" HintPath="$(BepInInterop)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Unity.Netcode.Runtime" HintPath="$(BepInInterop)\Unity.Netcode.Runtime.dll" Private="false" />

    <!-- Unity Interop Modules -->
    <Reference Include="UnityEngine" HintPath="$(BepInInterop)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(BepInInterop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(BepInInterop)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(BepInInterop)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(BepInInterop)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(BepInInterop)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TerrainModule" HintPath="$(BepInInterop)\UnityEngine.TerrainModule.dll" Private="false" />
  </ItemGroup>
</Project>
